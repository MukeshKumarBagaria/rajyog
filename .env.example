# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only by the protected
# admin user-provisioning actions and scripts/create-user.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────
# Public site URL, used for auth email redirects (invite / password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret used to sign the PIN-unlock cookie (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_LOCK_SECRET=change-me-to-a-long-random-string
