# ─── Supabase (Dashboard → Project Settings → API Keys) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser — RLS protects data.
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key (sb_secret_…). SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used only by the protected admin account actions and scripts/create-user.mjs.
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_your-key

# ─── App ─────────────────────────────────────────────────────────────
# Public site URL, used for auth email redirects (invite / password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret used to sign the PIN-unlock cookie (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_LOCK_SECRET=change-me-to-a-long-random-string
